{
  "name": "@org/website",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "website",
    "tags": [
      "scope:website"
    ],
    "targets": {
      "serve": {
        "continuous": true,
        "command": "next dev",
        "options": {
          "cwd": "apps/website"
        }
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck"
        ],
        "command": "tsc --noEmit",
        "options": {
          "cwd": "apps/website"
        }
      }
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@org/components": "^0.0.1",
    "@supabase/supabase-js": "^2.112.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3"
  }
}
